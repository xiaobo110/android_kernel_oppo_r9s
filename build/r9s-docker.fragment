# R9s (msm8953) 3.18.31 容器支持配置片段
# 用途：与 arch/arm64/configs/r9s_defconfig 通过 merge_config.sh 合并
# 命名已按本树 init/Kconfig 实测校准（本树 config MEMCG 存在且 depends on RESOURCE_COUNTERS，
# 原 defconfig 已有 RESOURCE_COUNTERS=y，所以 MEMCG 系列可用）。
# 本树没有的符号会被 olddefconfig 静默丢弃，由 CI 的校验步骤报告。

# --- namespaces（原 defconfig 明确关掉了 UTS_NS/PID_NS）---
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_KEYS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SYSVIPC=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- 让任意进程可建 socket：等价于 hengwu0 改 af_inet.c 的 return 1，但不动源码 ---
# 本树 net/Kconfig 里 ANDROID_PARANOID_NETWORK 为 default ANDROID，而 defconfig 有 CONFIG_ANDROID=y，
# 所以它当前是开着的 —— 这才是容器内无法联网的真正原因。
# CONFIG_ANDROID_PARANOID_NETWORK is not set

# --- cgroup ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CPUSETS=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_RT_GROUP_SCHED=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_IOSCHED_CFQ=y
CONFIG_CFQ_GROUP_IOSCHED=y
CONFIG_NET_CLS_CGROUP=y

# --- 内存 cgroup（init.qcom 已经 mount cgroup none /dev/memcg memory）---
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
CONFIG_MEMCG_KMEM=y

# --- devpts 多实例（容器 /dev/ptmx）---
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y

# --- 网络：bridge / veth / ipvlan / macvlan / tun ---
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_VETH=y
CONFIG_IPVLAN=y
CONFIG_MACVLAN=y
CONFIG_DUMMY=y
CONFIG_VXLAN=y
CONFIG_TUN=y

# --- netfilter / iptables（docker 的 MASQUERADE、-m set、-m comment 等）---
CONFIG_NETFILTER=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_IPV4=y
CONFIG_NF_NAT_NEEDED=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP_NF_TARGET_NETMAP=y
CONFIG_IP_NF_MATCH_AH=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_BRIDGE_NF_EBTABLES=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MAC=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_POLICY=y
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_QUOTA=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
# ipset 的 iptables 挂钩：作者补丁里写成 CONFIG_NETFILTER_XT_MARK（不存在的符号名），
# 真正的符号是下面这两个。
CONFIG_NETFILTER_XT_SET=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_IP_SET=y
CONFIG_IP_SET_MAX=256
CONFIG_IP_SET_BITMAP_IP=y
CONFIG_IP_SET_BITMAP_IPMAC=y
CONFIG_IP_SET_BITMAP_PORT=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_IPMARK=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_HASH_IPPORTIP=y
CONFIG_IP_SET_HASH_IPPORTNET=y
CONFIG_IP_SET_HASH_IPMAC=y
CONFIG_IP_SET_HASH_MAC=y
CONFIG_IP_SET_HASH_NETPORTNET=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_NETNET=y
CONFIG_IP_SET_HASH_NETPORT=y
CONFIG_IP_SET_HASH_NETIFACE=y
CONFIG_IP_SET_LIST_SET=y

# --- IPVS（作者补丁有，docker swarm/ingress 的 IPVS 转发模式用；iptables 模式不需要，
#     但体积很小，一并打开省事）---
CONFIG_IP_VS=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=y

# --- 存储 ---
CONFIG_OVERLAY_FS=y
# devicemapper 存储驱动（overlay2 之外的兜底；Android 本来就靠 dm 起 verity）
CONFIG_BLK_DEV_DM=y
CONFIG_DM_THIN_PROVISIONING=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_CONFIGFS_FS=y

# --- 密码学（docker/overlay 加密与 vxlan 需要）---
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AEAD=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_SEQIV=y
CONFIG_CRYPTO_GHASH=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_AES=y
CONFIG_XFRM=y
CONFIG_XFRM_USER=y
CONFIG_XFRM_ALGO=y
CONFIG_INET_ESP=y
CONFIG_INET_XFRM_MODE_TRANSPORT=y
CONFIG_INET_XFRM_MODE_TUNNEL=y
CONFIG_INET_AH=y

# --- 版本号后缀：保持与 crDroid 现有内核一致 ---
# 现机 uname -r = 3.18.31-perf（无 -g<sha> 尾巴），说明 crDroid 的构建把 auto version 关了。
# 这里也对齐，省得以后核对 vermagic 时被 git 后缀绕进去。
CONFIG_LOCALVERSION="-perf"
# CONFIG_LOCALVERSION_AUTO is not set

# --- 便于以后核对配置（现在设备上 /proc/config.gz 不存在）---
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- WiFi 必须是模块：crDroid 现内核里 pronto 不是 built-in（实测 Image 内无
# hdd_driver_init/ol_ap_start/qdf_memory 符号），init 靠 insmod pronto_wlan.ko 加载 ---
CONFIG_PRONTO_WLAN=m

# --- 作者补丁里有、这里故意不做的项 ---
# CONFIG_CGROUP_BPF     : 4.18+ 才有，3.18 树里不存在，写了也会被 olddefconfig 丢掉
# CONFIG_AUFS_FS        : 从未进过主线；本树没有 aufs 目录，docker 用 overlay2
# CONFIG_BTRFS_FS       : /data 是 ext4，btrfs 存储驱动已废弃，白占内核体积
# CONFIG_SECURITY_APPARMOR : 机器上没有 apparmor profile，且可能与现有 SELinux 策略互相干扰
# CONFIG_NF_*_FTP/TFTP  : 老连接跟踪 helper，现代 docker 反而会被它坑（端口改写）
# CONFIG_PRONTO_WLAN=y  : 不能开成 built-in，见上

